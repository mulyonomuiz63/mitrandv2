# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# MYSQL / MARIADB DATABASE CONFIGURATION (PRODUKSI & HOSTING)
# ==============================================================================
# Alamat host server MySQL Anda (contoh: localhost, 127.0.0.1, atau IP VPS)
MYSQL_HOST="127.0.0.1"

# Port MySQL (default: 3306)
MYSQL_PORT="3306"

# Username database MySQL Anda
MYSQL_USER="root"

# Password database MySQL Anda
MYSQL_PASSWORD=""

# Nama database MySQL Anda (buat terlebih dahulu di cPanel / phpMyAdmin / MySQL)
MYSQL_DATABASE="ndtaxlaw_db"

# Opsional: aktifkan SSL jika server MySQL hosting mewajibkan SSL (true/false)
MYSQL_SSL="false"

# MODE SISTEM: 'production' saat di hosting / VPS, 'development' saat uji coba lokal
APP_ENV="production"
NODE_ENV="production"

# ==============================================================================
# OPSIONAL — HANYA UNTUK MIGRASI SEKALI PAKAI DARI SUPABASE LAMA VIA CLI
# Jalankan: npm run migrate:mysql (setelah selesai migrasi, hapus 2 baris ini)
# ==============================================================================
# MIGRATE_SUPABASE_URL="https://your-old-project.supabase.co"
# MIGRATE_SUPABASE_KEY="your-old-supabase-service-role-key"
